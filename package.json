{
  "name": "sdd-harness",
  "version": "0.1.0",
  "description": "SDD Harness — AI DevOps workflow wrapper: 9-stage spec-driven governance with knowledge closed-loop",
  "type": "module",
  "bin": {
    "sdd": "bin/cli.js"
  },
  "files": [
    "bin",
    "lib",
    "templates",
    "scripts"
  ],
  "scripts": {
    "test": "node --test",
    "test:e2e:core": "node --test test/core-e2e.test.js",
    "test:e2e:claude": "node --test test/claude-adapter-contract.test.js",
    "test:adapter:preview": "node --test test/preview-adapter-contract.test.js",
    "test:e2e:live": "node scripts/live-e2e.js",
    "test:e2e:live:report": "node scripts/assert-live-report.js",
    "test:e2e:live:nightly": "node scripts/live-e2e-nightly.js"
  },
  "keywords": [
    "sdd",
    "openspec",
    "workflow",
    "cli",
    "trinity",
    "governance",
    "knowledge-base",
    "claude-code",
    "spec-driven"
  ],
  "author": "ql",
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/yourorg/sdd-harness"
  },
  "dependencies": {
    "chalk": "^5.3.0",
    "commander": "^12.0.0",
    "fs-extra": "^11.2.0"
  }
}
