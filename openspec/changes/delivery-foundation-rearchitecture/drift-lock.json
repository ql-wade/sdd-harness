  "frozen_interfaces": [
    "Comet.Run.managedDelivery.v1: same RunState/lock/transaction, no second currentPhase",
    "SDD.Gate.v1: pure evaluate(inputs,receipts,policy), no dispatch",
    "Knowledge.Closeout.v1: Kp before archive, Kt before overall completion",
    "Runner.Dispatch.v1: trusted launcher binds run/gate/input/policy/attempt/epoch, worker cannot write control state",
    "Comet.SourcePreparation.v1: prepareCometSource({projectRoot,lock,archivePath}) returns canonical pristine source and verified provenance",
    "Comet.DistributionBuild.v1: buildCometDistribution({projectRoot,lock,archivePath}) returns buildRoot, entrypoint, sourceCommit, fingerprint with exact toolchain precondition",
    "Registry.v1 -> project/resource/owner/credentialRef/lockRef/authority/domain/retention, no secret values",
    "SecretRef.v1 -> purpose-bound opaque reference resolved only by allowed service principal",
    "Qualification.v1 -> exact source commit, image digest/platform/size, license, health API and backup compatibility evidence before up",
    "RunnerInfra.v1 validate|qualify|up|probe|stop -> process/mount/principal observations only",
    "RoleBoundary.v1 -> immutable tool image, distinct principal/mount/credential scopes for controller/author/test-author/reviewer/publisher/isolator",
    "Authority.v1 -> one fixed Comet authority and workspace",
    "startup refuses copied state or concurrent writer",
    "OutlineInfra.v1 validate|qualify|up|probe|stop -> actual API/UI/storage/principal evidence",
    "OutlineDomain.v1 -> instance/collection immutable IDs, actual effective reader set and registered owner",
    "OutlineState.v1 -> durable database+attachment storage",
    "cache is not rights authority",
    "API contracts include fixed create UUID and lastRevision only if verified",
    "ProjectWikiInfra.v1 validate|qualify|probe -> canonical project/wiki/index identity and MCP read/write observations",
    "ProjectRoot.v1 -> projectID/repoID/wikiRoot/worktree mapping, contained paths only",
    "KnowledgeWrite.v1 -> approved curated entry plus source/revision and independent readback",
    "no task/phase/spec authority",
    "CodeKnowledgeInfra.v1 validate|qualify|probe -> selfhost code-wiki and separate graph provenance/freshness evidence",
    "CodeWiki.v1 -> repository immutableID/commit and wiki generation manifest, approved code access scope",
    "CodeGraph.v1 -> structure-only index with exact input commit/coverage",
    "removable optimization, no gate or knowledge authority",
    "PlatformInfra.v1 validate|probe -> repository identity/permissions/check policy/registry/environment evidence, no implicit remote policy writes",
    "IntegrationIdentity.v1 -> PR head/mergeSHA -> build artifact digest -> target deployment identity",
    "Environment.v1 -> isolated endpoint/owner/rollback authorization and readback oracle",
    "Health.v1 -> heartbeat_age, complete_scan_watermark, unresolved_isolation/deadlines and authority identity",
    "read-only",
    "Monitor.v1 -> external fault-domain registration and alert delivery/ack/escalation only, never business phase/retry/ACL",
    "Supervisor.v1 -> restart same fixed Comet authority only after old writer gone",
    "bounded attempts and escalation",
    "Backup.v1 -> consistent manifest of Comet state/transaction/receipts/approved payload plus knowledge/database/objects/config refs",
    "Restore.v1 -> restore into quarantine, authenticate current permissions, fence old writer, verify same operation and readback before release",
    "Retention.v1 -> R10 A: unresolved Run/knowledge obligation retains sole workspace",
    "cleanup requires verified completed or separately approved migration+restore proof",
    "SDD.Verification.Journey.v2: observer requires exact targets and typed terminal readback and observes real Comet Run without controlling phase or recovery",
    "Comet.GateRevision.v2: same Run persists monotonic requirement and design revisions and trusted reviewer result binding and never revives invalidated receipts by restoring bytes"
  ],
  "global_constraints": [
    "Comet Classic is sole target runtime controller; TeamAI distributes only",
    "Matt reusable methods only; no Superpowers restart or nested planner/implement-spec controller",
