+// ---- run authority binding (0003, H09) --------------------------------------
+//
+// One run, one authoritative environment (R01 A): the binding is recorded by
+// the Runtime from the RUNTIME ENVIRONMENT configuration (never from a
+// client-filled host/session label), lives in the run's own .comet directory,
+// and every mutating closeout-window entrance verifies it. Other hosts keep
+// read-only query access; writes require the bound authority or an explicit,
+// Runtime-performed transfer.
+
+export interface RunAuthorityTransfer {
+  from: string;
+  to: string;
+  at: string;
+}
+
+export interface RunAuthorityFile {
+  schema: 'comet.classic.run-authority.v1';
+  authorityId: string;
+  boundAt: string;
+  transfers: RunAuthorityTransfer[];
+}
+
+const RUN_AUTHORITY_FILE = '.comet/run-authority.json';
+
+export class RunAuthorityError extends Error {
+  constructor(message: string) {
+    super(message);
+    this.name = 'RunAuthorityError';
+  }
+}
+
+export function currentRunAuthorityId(): string {
+  const configured = process.env.COMET_RUN_AUTHORITY;
+  return configured && configured.trim() !== '' ? configured.trim() : hostname();
+}
+
+export async function readRunAuthority(changeDir: string): Promise<RunAuthorityFile | null> {
+  const raw = await readOptionalEngineRunText(changeDir, RUN_AUTHORITY_FILE, Number.MAX_SAFE_INTEGER, 'Run authority binding');
+  if (raw === null) return null;
+  const value = JSON.parse(raw) as RunAuthorityFile;
+  if (
+    !value ||
+    value.schema !== 'comet.classic.run-authority.v1' ||
+    typeof value.authorityId !== 'string' ||
+    value.authorityId === '' ||
+    !Array.isArray(value.transfers)
+  ) {
+    throw new Error('Invalid Classic run authority binding');
+  }
+  return value;
+}
+
+async function writeRunAuthority(changeDir: string, file: RunAuthorityFile): Promise<void> {
+  await writeEngineRunText(
+    changeDir,
+    RUN_AUTHORITY_FILE,
+    `${stableStringify(file)}\n`,
+    Number.MAX_SAFE_INTEGER,
+    'Run authority binding',
+  );
+}
+
+// Create-if-absent at managed init: the first environment to run the Runtime
+// becomes the authoritative one; later binds never overwrite.
+export async function bindRunAuthority(changeDir: string): Promise<RunAuthorityFile> {
+  const existing = await readRunAuthority(changeDir);
+  if (existing) return existing;
+  const file: RunAuthorityFile = {
+    schema: 'comet.classic.run-authority.v1',
+    authorityId: currentRunAuthorityId(),
+    boundAt: new Date().toISOString(),
+    transfers: [],
+  };
+  await writeRunAuthority(changeDir, file);
+  return file;
+}
+
+// The transfer is performed BY the authoritative environment (the caller has
+// already passed requireRunAuthority) and recorded in the binding itself.
+export async function transferRunAuthority(changeDir: string, to: string): Promise<RunAuthorityFile> {
+  const existing = await readRunAuthority(changeDir);
+  if (!existing) throw new RunAuthorityError('ERROR: this run has no authority binding to transfer');
+  if (to === existing.authorityId) return existing;
+  const file: RunAuthorityFile = {
+    ...existing,
+    authorityId: to,
+    transfers: [...existing.transfers, { from: existing.authorityId, to, at: new Date().toISOString() }],
+  };
+  await writeRunAuthority(changeDir, file);
+  return file;
+}
+
+// H09 gate for every mutating closeout-window entrance: a copied workspace
+// under a foreign authority is refused as a second writer; queries stay open.
+export async function requireRunAuthority(changeDir: string): Promise<void> {
+  const binding = await readRunAuthority(changeDir);
+  if (!binding) return;
+  const current = currentRunAuthorityId();
+  if (current !== binding.authorityId) {
+    throw new RunAuthorityError(
+      `ERROR: run authority mismatch: this workspace is bound to authoritative environment '${binding.authorityId}' but the current environment is '${current}'. Return to the authoritative environment or perform an explicit, confirmed authority transfer; a copied workspace never becomes a second writer (H09)`,
+    );
+  }
+}
