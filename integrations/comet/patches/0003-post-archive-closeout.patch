+// ---- post-archive continuation (0003) --------------------------------------
+
+// H01 shared predicate: an archived change whose Git delivery verification is
+// complete is excluded from discovery/selection ONLY when its managed
+// knowledge-closeout obligation is met. A closeout-pending run stays
+// discoverable and selectable on the SAME run after the archive move.
+export function archivedDeliveryExcluded(
+  classic: {
+    managedDelivery?: boolean;
+    knowledgeCloseoutRequired?: boolean;
+    knowledgeCloseout?: unknown;
+  },
+  verificationStatus: string,
+): boolean {
+  return (
+    ['complete', 'local-verified'].includes(verificationStatus) &&
+    !knowledgeCloseoutBlocked(classic)
+  );
+}
+
+// Snake-case document record -> the closeout predicate input (shared by the
+// callers that read .comet.yaml directly instead of the parsed projection).
+export function closeoutPredicateFromDocument(record: Record<string, unknown>): {
+  managedDelivery: boolean;
+  knowledgeCloseoutRequired: boolean;
+  knowledgeCloseout: unknown;
+} {
+  return {
+    managedDelivery: record.managed_delivery === true,
+    knowledgeCloseoutRequired: record.knowledge_closeout_required === true,
+    knowledgeCloseout: record.knowledge_closeout ?? null,
+  };
+}
+
+// ---- knowledge publish operations (0003, H04/H05) ---------------------------
+//
+// The Outline publication ledger of the SAME run: one operation per logical
+// knowledge entry revision. The document UUID is fixed at first registration
+// (before any remote request) and retries recover the SAME operation; remote
+// observations classify what actually happened (absent / exists / conflict /
+// unknown) and unknown is never absence (H04); a lastRevision conflict stays
+// open until an independent readback resolves it, and the revision is never
+// refreshed into a blind overwrite (H05). Same ledger file discipline as the
+// gate dispatch registry: the run's own .comet directory, atomic writer, no
+// second control plane.
+
+export const UUID_RE = /^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/u;
+export const MAX_KNOWLEDGE_OPERATIONS = 200;
+
+export type KnowledgeObservationOutcome = 'absent' | 'exists' | 'conflict' | 'unknown';
+
+export interface KnowledgeObservation {
+  outcome: KnowledgeObservationOutcome;
+  revision: string | null;
+  readbackDigest: string | null;
+  at: string;
+}
+
+export interface KnowledgePublishOperation {
+  operationKey: string;
+  knowledgeId: string;
+  documentId: string;
+  collection: string;
+  payloadDigest: string;
+  baseRevision: string | null;
+  lastRevision: string | null;
+  state: 'pending' | 'conflict' | 'published';
+  attempts: number;
+  lastObservation: KnowledgeObservation | null;
+  createdAt: string;
+  updatedAt: string;
+}
+
+export interface KnowledgePublishFile {
+  schema: 'comet.classic.knowledge-publish.v1';
+  operations: KnowledgePublishOperation[];
+}
+
+const KNOWLEDGE_PUBLISH_FILE = '.comet/knowledge-publish-operations.json';
+
+export function knowledgeOperationKey(input: {
+  knowledgeId: string;
+  collection: string;
+  payloadDigest: string;
+}): string {
+  return sha256Text(
+    stableStringify({
+      knowledgeId: input.knowledgeId,
+      collection: input.collection,
+      payloadDigest: input.payloadDigest,
+    }),
+  );
+}
+
+export async function readKnowledgePublishOperations(changeDir: string): Promise<KnowledgePublishFile> {
+  const raw = await readOptionalEngineRunText(changeDir, KNOWLEDGE_PUBLISH_FILE, Number.MAX_SAFE_INTEGER, 'Knowledge publish ledger');
+  if (raw === null) return { schema: 'comet.classic.knowledge-publish.v1', operations: [] };
+  const value = JSON.parse(raw) as KnowledgePublishFile;
+  if (
+    !value ||
+    value.schema !== 'comet.classic.knowledge-publish.v1' ||
+    !Array.isArray(value.operations)
+  ) {
+    throw new Error('Invalid Classic knowledge publish ledger');
+  }
+  return value;
+}
+
+export async function writeKnowledgePublishOperations(
+  changeDir: string,
+  file: KnowledgePublishFile,
+): Promise<void> {
+  if (file.operations.length > MAX_KNOWLEDGE_OPERATIONS) {
+    throw new Error(
+      `Knowledge publish ledger exceeds ${MAX_KNOWLEDGE_OPERATIONS} operations; reconcile ${KNOWLEDGE_PUBLISH_FILE} before publishing again`,
+    );
+  }
+  await writeEngineRunText(
+    changeDir,
+    KNOWLEDGE_PUBLISH_FILE,
+    `${stableStringify(file)}\n`,
+    Number.MAX_SAFE_INTEGER,
+    'Knowledge publish ledger',
+  );
+}
+
+// The next Comet-side directive for a registered publication operation. The
+// adapter (thin Outline MCP/API surface) executes exactly this directive; it
+// never decides the business next step.
+export function knowledgePublishDirective(operation: KnowledgePublishOperation): {
+  action: string;
+  documentId: string;
+  lastRevision?: string;
+  reason?: string;
+} {
+  if (operation.state === 'conflict') {
+    return {
+      action: 'reconcile-readback',
+      documentId: operation.documentId,
+      reason: '409 conflict: read back the registered document and reconcile; do not refresh the revision and overwrite the remote edit (H05)',
+    };
+  }
+  if (operation.lastObservation?.outcome === 'unknown') {
+    return {
+      action: 'reconcile-info',
+      documentId: operation.documentId,
+      reason: '403/timeout is not absence: read the fixed document UUID back (documents.info) before any create (H04)',
+    };
+  }
+  if (operation.lastObservation?.outcome === 'exists') {
+    return {
+      action: 'record-closeout',
+      documentId: operation.documentId,
+      reason: 'the independent readback matches the registered payload; record the knowledge closeout',
+    };
+  }
+  if (operation.lastObservation?.outcome === 'absent') {
+    return {
+      action: 'create',
+      documentId: operation.documentId,
+      ...(operation.baseRevision ? { lastRevision: operation.baseRevision } : {}),
+      reason: 'confirmed absent: create with the SAME fixed document UUID (H04)',
+    };
+  }
+  return {
+    action: operation.baseRevision ? 'update' : 'create',
+    documentId: operation.documentId,
+    ...(operation.baseRevision ? { lastRevision: operation.baseRevision } : {}),
+  };
+}
