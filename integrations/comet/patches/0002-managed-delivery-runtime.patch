+// B1 required-check identity registry: every v2 command entry that declares a
+// requiredScope, keyed by that scope. An empty registry keeps the historical
+// behavior (any recorded runtime evidence for the scope can satisfy it).
+export async function readRequiredCheckIdentities(
+  root: string,
+): Promise<Partial<Record<'build' | 'verify', CheckPolicyCommand[]>>> {
+  if (
+    !(await classicProjectTargetExists(root, CHECK_POLICY_PATH, {
+      label: 'Classic check policy',
+      expected: 'file',
+    }))
+  )
+    return {};
+  const raw = await readClassicProjectFile(root, CHECK_POLICY_PATH, {
+    label: 'Classic check policy',
+  });
+  let value: unknown;
+  try {
+    value = JSON.parse(raw);
+  } catch (error) {
+    throw new Error(`Invalid Classic check policy: ${error instanceof Error ? error.message : String(error)}`, { cause: error });
+  }
+  if (!value || typeof value !== 'object' || Array.isArray(value) || (value as Record<string, unknown>).version !== 2) {
+    return {};
+  }
+  const registry: Partial<Record<'build' | 'verify', CheckPolicyCommand[]>> = {};
+  for (const entry of (value as Record<string, unknown>).commands as unknown[]) {
+    const command = parseCommandEntry(entry, 'Classic check policy commands');
+    if (!command.requiredScope) continue;
+    (registry[command.requiredScope] ??= []).push(command);
+  }
+  return registry;
+}
+
+export function checkIdentityMatches(identity: CheckIdentity, command: CheckPolicyCommand): boolean {
+  return matchesIdentity(command, identity);
+}
