new file mode 100644
index 0000000..9f46b14
--- /dev/null
+++ b/domains/comet-classic/classic-managed-host.ts
@@ -0,0 +1,215 @@
+// Fixed in-process host binding. Only the trusted bootstrap calls install;
+// CLI/JSON/environment/module paths cannot select an admission consumer.
+// Registration proves code wiring only. I02/P1_3 own OS, installation and
+// process integrity; this module does not qualify a source by itself.
+export type ManagedRecord = Record<string, any>;
+export interface ManagedDeliveryHost {
+  authority: {
+    issueDispatch(binding: ManagedRecord): ManagedRecord;
+    verifyDispatch(record: ManagedRecord): ManagedRecord;
+    collectResult(packet: ManagedRecord): Promise<ManagedRecord>;
+    verifyCollection(packet: ManagedRecord): ManagedRecord;
+  };
+  // Pure projection of already-read protected policy/source/Run facts.
+  context(intent: ManagedRecord): ManagedRecord;
+  policy(scope: ManagedRecord): ManagedRecord;
+  definitionDigest(source: string): string;
+  authorizeWrite(request: ManagedRecord): ManagedRecord;
+  // Actual launch/artifact readback; invoked only outside the state lock.
+  readResult(intent: ManagedRecord, submitted: ManagedRecord): Promise<ManagedRecord>;
+  // Bind the original P2_2 functions, not a worker's boolean verdict.
+  admitEvidence(packet: ManagedRecord, options: ManagedRecord): ManagedRecord;
+  evaluate(
+    inputs: ManagedRecord,
+    entries: ManagedRecord[],
+    policy: ManagedRecord,
+    options: ManagedRecord,
+  ): ManagedRecord;
+  verifyReview(request: ManagedRecord): ManagedRecord;
+}
+export class ManagedSourceUnverifiedError extends Error {
+  constructor(message: string) {
+    super(message);
+    this.name = 'ManagedSourceUnverifiedError';
+  }
+}
+let installed: Readonly<ManagedDeliveryHost> | null = null;
+const syncCode = (fn: unknown): boolean =>
+  typeof fn === 'function' &&
+  !['AsyncFunction', 'GeneratorFunction', 'AsyncGeneratorFunction'].includes(fn.constructor.name);
+export function installManagedDeliveryHost(host: ManagedDeliveryHost): void {
+  if (installed) throw new Error('Managed host is already bound; replacement is forbidden');
+  if (
+    !host ||
+    !host.authority ||
+    !syncCode(host.authority.issueDispatch) ||
+    !syncCode(host.authority.verifyDispatch) ||
+    !syncCode(host.authority.verifyCollection) ||
+    typeof host.authority.collectResult !== 'function' ||
+    typeof host.readResult !== 'function' ||
+    ![
+      host.context,
+      host.policy,
+      host.definitionDigest,
+      host.authorizeWrite,
+      host.admitEvidence,
+      host.evaluate,
+      host.verifyReview,
+    ].every(syncCode)
+  ) {
+    throw new Error(
+      'Managed host requires fixed code ports for collector, strict admission and pure Gate',
+    );
+  }
+  installed = Object.freeze({
+    authority: Object.freeze({
+      issueDispatch: host.authority.issueDispatch,
+      verifyDispatch: host.authority.verifyDispatch,
+      collectResult: host.authority.collectResult,
+      verifyCollection: host.authority.verifyCollection,
+    }),
+    context: host.context,
+    policy: host.policy,
+    definitionDigest: host.definitionDigest,
+    authorizeWrite: host.authorizeWrite,
+    readResult: host.readResult,
+    admitEvidence: host.admitEvidence,
+    evaluate: host.evaluate,
+    verifyReview: host.verifyReview,
+  });
+}
+export function managedDeliveryHost(): Readonly<ManagedDeliveryHost> | null {
+  return installed;
+}
+export function requireManagedDeliveryHost(): Readonly<ManagedDeliveryHost> {
+  if (!installed)
+    throw new ManagedSourceUnverifiedError(
+      'UNVERIFIED: protected managed source/admission/review host is not installed',
+    );
+  return installed;
+}
+
+// Preserve standard Node Buffer JSON across the existing YAML transaction.
+// Only the three raw packet fields are decoded, never arbitrary input code.
+export function restoreManagedEntry(entry: ManagedRecord): ManagedRecord {
+  const packet = { ...entry.sourcePacket };
+  for (const key of ['reportBytes', 'resultBytes', 'methodTraceBytes']) {
+    const raw = packet[key];
+    if (Buffer.isBuffer(raw)) continue;
+    if (raw instanceof Uint8Array) {
+      packet[key] = Buffer.from(raw);
+      continue;
+    }
+    if (
+      !raw ||
+      raw.type !== 'Buffer' ||
+      !Array.isArray(raw.data) ||
+      !raw.data.every(
+        (byte: unknown) =>
+          Number.isInteger(byte) && (byte as number) >= 0 && (byte as number) <= 255,
+      )
+    ) {
+      throw new ManagedSourceUnverifiedError(
+        'UNVERIFIED: persisted original source bytes are missing or malformed',
+      );
+    }
+    packet[key] = Buffer.from(raw.data);
+  }
+  return { ...entry, sourcePacket: packet };
+}
+
+export function evaluateManagedSource(
+  intent: ManagedRecord,
+  supplied: ManagedRecord,
+  receipts: ManagedRecord[],
+  readback = false,
+): ManagedRecord {
+  const host = requireManagedDeliveryHost();
+  const entry = restoreManagedEntry(supplied);
+  const context = host.context(intent);
+  const action = context.actionBinding;
+  if (
+    !action ||
+    action.run !== intent.nativeRunId ||
+    action.profile !== 'comet-managed-v2' ||
+    action.execution !== intent.execution ||
+    action.attempt !== intent.attempt ||
+    action.epoch !== intent.epoch ||
+    action.gate !== intent.gate ||
+    action.inputDigest !== intent.inputDigest ||
+    !intent.protectedDispatch
+  ) {
+    throw new ManagedSourceUnverifiedError(
+      'UNVERIFIED: current protected ActionBinding does not match the native intent',
+    );
+  }
+  const recorded = receipts.filter((receipt) => receipt.sourceEntry);
+  const options = {
+    ...context.admissionOptions,
+    requireManaged: true,
+    authority: host.authority,
+    actionBinding: action,
+    consumedCollections: recorded.map((receipt) => receipt.sourceEntry.collectionId),
+    issuedExecutions: recorded.map((receipt) => receipt.sourceEntry.execution),
+    ...(readback ? { acceptedEntry: entry } : {}),
+  };
+  if (!readback) {
+    const admitted = host.admitEvidence(
+      { ...entry.sourcePacket, dispatch: intent.protectedDispatch, envelope: entry.envelope },
+      options,
+    );
+    if (!admitted.ok)
+      throw new ManagedSourceUnverifiedError(
+        `UNVERIFIED: strict managed admission refused (${admitted.error})`,
+      );
+  }
+  // The original P2_2 Gate owns exact recorded-entry replay exclusion. Direct
+  // admission intentionally rejects consumed collections even on readback.
+  const inputs = {
+    inputDigest: action.inputDigest,
+    testContract: context.testContract,
+    builderExecution: options.builderExecution,
+  };
+  const evaluated = host.evaluate(inputs, [entry], context.policy, {
+    requireManaged: true,
+    admissionOptionsFor: () => options,
+    verifyReview: host.verifyReview,
+  });
+  // A missing completed review is unverified, not an authenticated rejection.
+  const review = host.verifyReview({ entry, inputs, policy: context.policy });
+  if (
+    !review ||
+    review.ok !== true ||
+    review.envelopeDigest !== entry.digest ||
+    review.reportDigest !== entry.sourcePacket.collection.reportDigest ||
+    review.actionDigest !== entry.sourcePacket.collection.actionDigest
+  ) {
+    throw new ManagedSourceUnverifiedError(
+      'UNVERIFIED: current completed independent semantic review is missing',
+    );
+  }
+  return { entry, evaluated };
+}
+
+export function admitManagedPacket(
+  intent: ManagedRecord,
+  packet: ManagedRecord,
+  receipts: ManagedRecord[],
+): ManagedRecord {
+  const host = requireManagedDeliveryHost();
+  const context = host.context(intent);
+  const recorded = receipts.filter((receipt) => receipt.sourceEntry);
+  const admitted = host.admitEvidence(packet, {
+    ...context.admissionOptions,
+    requireManaged: true,
+    authority: host.authority,
+    actionBinding: context.actionBinding,
+    consumedCollections: recorded.map((receipt) => receipt.sourceEntry.collectionId),
+    issuedExecutions: recorded.map((receipt) => receipt.sourceEntry.execution),
+  });
+  if (!admitted.ok)
+    throw new ManagedSourceUnverifiedError(
+      `UNVERIFIED: collected source was not admitted (${admitted.error})`,
+    );
+  return evaluateManagedSource(intent, admitted.entry, receipts);
+}
