+      projectRoot,
+      changeDir,
+      classic: classic as unknown as Record<string, unknown>,
+      run: projection.run,
+    });
+    evidence.push(...gateItems);
+  }
+
+  if (classic?.managedDelivery && classic.archived) {
+    try {
+      const delivery = await readClassicDelivery(projectRoot, changeDir);
+      evidence.push({ code: 'delivery.current', satisfied: ['complete', 'local-verified'].includes(delivery.verification.status), detail: delivery.verification.status });
+    } catch (error) {
+      evidence.push({ code: 'delivery.current', satisfied: false, detail: `UNVERIFIED: ${error instanceof Error ? error.message : String(error)}` });
+    }
+  }
   return evidence;
 }
