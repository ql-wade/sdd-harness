index 0000000..439ffb3
--- /dev/null
+++ b/test/domains/comet-classic/managed-transaction-crash.test.ts
@@ -0,0 +1,131 @@
+import { it, expect } from 'vitest';
+import { promises as fs, writeSync } from 'node:fs';
+import os from 'node:os';
+import path from 'node:path';
+import { spawn } from 'node:child_process';
+import { once } from 'node:events';
+import { build } from 'esbuild';
+import { runClassicCli } from '../../../domains/comet-classic/classic-cli.js';
+import { ensureClassicRuntimeRun } from '../../../domains/comet-classic/classic-runtime-run.js';
+import {
+  readClassicState,
+  writeClassicState,
+} from '../../../domains/comet-classic/classic-store.js';
+
+it('actual killed writer recovers dispatch and receipt together in the original Run transaction', async () => {
+  const root = await fs.mkdtemp(path.join(os.tmpdir(), 'native-managed-crash-'));
+  let child: ReturnType<typeof spawn> | undefined;
+  let exited: Promise<unknown> | undefined;
+  try {
+    await fs.mkdir(path.join(root, '.comet'), { recursive: true });
+    await fs.writeFile(
+      path.join(root, '.comet/config.yaml'),
+      'schema: comet.project.v1\ndefault_workflow: classic\nworkflows: [classic]\nclassic:\n  artifact_layout: legacy\n',
+    );
+    await fs.mkdir(path.join(root, 'openspec'), { recursive: true });
+    await fs.writeFile(path.join(root, 'openspec/config.yaml'), 'schema: spec-driven\n');
+    const initialized = await runClassicCli(
+      ['state', 'init', 'crash', 'full', '--managed-delivery'],
+      undefined,
+      { projectRoot: root, invocationCwd: root },
+    );
+    expect(initialized.exitCode).toBe(0);
+    const directory = path.join(root, 'openspec/changes/crash');
+    await ensureClassicRuntimeRun(directory);
+    const before = await readClassicState(directory, { migrate: false });
+    expect(before.classic).not.toBeNull();
+    expect(before.run).not.toBeNull();
+    // This is rejected structural fixture data, never a signed passing gate.
+    const registry = {
+      schema: 'comet.classic.gate-dispatches.v1',
+      dispatches: [{ gate: 'R', execution: 'transaction-fixture', state: 'open' }],
+    };
+    await writeClassicState(directory, {
+      ...before,
+      classic: { ...before.classic!, gateDispatches: JSON.stringify(registry), gateReceipts: '[]' },
+    });
+    const baseline = await readClassicState(directory, { migrate: false });
+    const marker = path.join(root, 'writer-reached-before-yaml');
+    const worker = path.join(root, 'writer.mjs');
+    await build({
+      stdin: {
+        contents: `
+      import {promises as fs} from 'node:fs';
+      import {readClassicState,writeClassicState} from ${JSON.stringify(path.resolve('domains/comet-classic/classic-store.ts'))};
+      const directory=process.argv[2], marker=process.argv[3];
+      const before=await readClassicState(directory,{migrate:false});
+      const registry=JSON.parse(before.classic.gateDispatches);
+      registry.dispatches[0].state='consumed';
+      await writeClassicState(directory,{...before,classic:{...before.classic,gateDispatches:JSON.stringify(registry),gateReceipts:JSON.stringify([{transactionFixture:'rejected-not-authenticated'}])},run:{...before.run,iteration:before.run.iteration+1}}, {beforeCommit:async()=>{await fs.writeFile(marker,'Run written, YAML not committed');await new Promise(()=>setInterval(()=>{},1000));}});
+    `,
+        resolveDir: process.cwd(),
+        loader: 'ts',
+      },
+      outfile: worker,
+      bundle: true,
+      platform: 'node',
+      format: 'esm',
+      target: 'node24',
+      banner: {
+        js: "import{createRequire}from'node:module';const require=createRequire(import.meta.url);",
+      },
+    });
+    child = spawn(process.execPath, [worker, directory, marker], {
+      stdio: ['ignore', 'pipe', 'pipe'],
+    });
+    exited = once(child, 'exit');
+    const deadline = Date.now() + 10000;
+    while (Date.now() < deadline) {
+      if (
+        await fs.stat(marker).then(
+          () => true,
+          () => false,
+        )
+      )
+        break;
+      await new Promise((r) => setTimeout(r, 10));
+    }
+    expect(await fs.readFile(marker, 'utf8')).toContain('YAML not committed');
+    expect(await fs.stat(path.join(directory, '.comet-state-transaction.json'))).toBeTruthy();
+    const intermediate = JSON.parse(
+      await fs.readFile(path.join(directory, '.comet/run-state.json'), 'utf8'),
+    );
+    expect(intermediate.runId).toBe(baseline.run!.runId);
+    expect(intermediate.iteration).toBe(baseline.run!.iteration + 1);
+    const killed = child.kill('SIGKILL');
+    expect(killed).toBe(true);
+    const terminal = (await exited) as [number | null, string | null];
+    expect(terminal[1]).toBe('SIGKILL');
+    const recovered = await readClassicState(directory, { migrate: false });
+    expect(recovered.run!.runId).toBe(baseline.run!.runId);
+    expect(recovered.run!.iteration).toBe(baseline.run!.iteration);
+    expect(recovered.classic!.phase).toBe('open');
+    expect(JSON.parse(recovered.classic!.gateDispatches!).dispatches[0].state).toBe('open');
+    expect(JSON.parse(recovered.classic!.gateReceipts!)).toEqual([]);
+    expect(
+      await fs.stat(path.join(directory, '.comet-state-transaction.json')).then(
+        () => true,
+        () => false,
+      ),
+    ).toBe(false);
+    writeSync(
+      2,
+      JSON.stringify({
+        scope: 'component/original-native-transaction-crash',
+        pid: child.pid,
+        signal: terminal[1],
+        runId: recovered.run!.runId,
+        phase: recovered.classic!.phase,
+        dispatch: 'open',
+        receipts: 0,
+        businessAcceptedScenarios: 0,
+      }) + '\n',
+    );
+  } finally {
+    if (child && child.exitCode === null && child.signalCode === null) {
+      child.kill('SIGKILL');
+      if (exited) await exited;
+    }
+    await fs.rm(root, { recursive: true, force: true, maxRetries: 5, retryDelay: 100 });
+  }
+}, 20000);
