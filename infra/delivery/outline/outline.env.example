# Outline 独立资料域环境模板（OutlineInfra.v1）— 仅声明绑定，绝不存任何秘密值。
# 变量集合必须按选定 Outline 版本核对（当前版本未选定：应用配置参数 UNVERIFIED）。
# 绑定规则：敏感变量值只能是 secret-ref:sdd-harness-pilot/<name>，由运行时授权机制在挂载时解析展开；
# 具体非敏感值仅允许 allowlist 键（URL/PORT/FORCE_HTTPS/NODE_ENV/OIDC_DISPLAY_NAME/OIDC_SCOPES）。
# 缺口：UTILS_SECRET 需要独立 secret-ref，I03 计划的 7 个引用中没有对应项——保持空值，不得用占位值填充。

PORT=3000
URL=http://127.0.0.1:3000
FORCE_HTTPS=false
NODE_ENV=production
OIDC_DISPLAY_NAME=SDD Harness Pilot
OIDC_SCOPES=openid profile email

SECRET_KEY=secret-ref:sdd-harness-pilot/outline-app-session
UTILS_SECRET=
DATABASE_URL=secret-ref:sdd-harness-pilot/outline-db
REDIS_URL=secret-ref:sdd-harness-pilot/outline-redis
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=secret-ref:sdd-harness-pilot/outline-oidc-client
OIDC_ISSUER_URL=
OIDC_AUTH_URI=
OIDC_TOKEN_URI=
OIDC_USERINFO_URI=
OIDC_LOGOUT_URI=
AWS_S3_UPLOAD_ACCESS_KEY_ID=secret-ref:sdd-harness-pilot/outline-object-store
AWS_S3_UPLOAD_SECRET_ACCESS_KEY=secret-ref:sdd-harness-pilot/outline-object-store
AWS_S3_UPLOAD_BUCKET_URL=
AWS_S3_UPLOAD_BUCKET_NAME=
AWS_S3_UPLOAD_REGION=
