{
  "schemaVersion": 1,
  "interface": "OutlineStoragePolicy.v1",
  "project": "sdd-harness-pilot",
  "note": "对象存储与状态策略（OutlineState.v1）：结构在位，endpoint/bucket/TTL 全部未选定；不得假定附件撤回立即生效；cache 仅缓存，永非权限权威。",
  "storage": {
    "type": "UNSELECTED",
    "endpoint": null,
    "bucket": null,
    "region": null,
    "credentialRef": "secret-ref:sdd-harness-pilot/outline-object-store",
    "status": "UNVERIFIED"
  },
  "signedUrl": {
    "defaultTtlSeconds": null,
    "maxTtlSeconds": null,
    "status": "UNVERIFIED",
    "reason": "签名 URL 期限与密钥轮换输入未确定；期限选定前不得启用公开附件分发"
