{
  "schemaVersion": 1,
  "interface": "Qualification.v1",
  "imageReference": {
    "digestFormat": "^sha256:[0-9a-f]{64}$",
    "digestPinnedRequired": true,
    "floatingTagsForbidden": true
  },
  "evidenceCategories": [
    "source-commit",
    "source-digest",
    "artifact-size",
    "image-digest",
    "platform",
    "license",
    "health-api",
    "backup-compatibility"
  ],
  "upGate": {
    "requireAllCategoriesVerified": true,
    "enabled": false,
    "refusalReason": "I01 registers and qualifies resources only; component up is owned by later infra tasks and requires runtime authorization that does not exist yet"
  },
  "roles": [
    "controller",
    "author",
    "test-author",
    "reviewer",
    "publisher",
    "isolator",
    "service",
    "ci",
    "monitor",
    "backup"
  ],
  "secretValueKeyNames": ["value", "secret", "token", "password", "passwd", "apikey"],
  "forbiddenHostPathPrefixes": ["/Users/", "/home/", "/root/", "/private/", "/var/", "/usr/", "/etc/", "/opt/", "/tmp/"]
}
