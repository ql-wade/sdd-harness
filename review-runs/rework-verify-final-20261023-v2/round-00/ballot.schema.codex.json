{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "title": "Multi-Agent Consensus Review ballot",
 "type": "object",
 "additionalProperties": false,
 "required": [
  "review_id",
  "round",
  "agent",
  "artifact_sha256",
  "verdict",
  "score",
  "findings",
  "assumptions",
  "confidence",
  "summary"
 ],
 "properties": {
  "review_id": {
   "type": "string",
   "minLength": 1
  },
  "round": {
   "type": "integer",
   "minimum": 0
  },
  "agent": {
   "type": "string",
   "minLength": 1
  },
  "artifact_sha256": {
   "type": "string",
   "pattern": "^[0-9a-f]{64}$"
  },
  "verdict": {
   "enum": [
    "APPROVE",
    "REJECT",
    "ABSTAIN"
   ]
  },
  "score": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "overall",
    "criteria"
   ],
   "properties": {
    "overall": {
     "type": "number",
     "minimum": 0,
     "maximum": 10
    },
    "criteria": {
     "type": "object",
     "additionalProperties": false,
     "properties": {
      "correctness": {
       "type": "number"
      },
      "completeness": {
       "type": "number"
      },
      "risk": {
       "type": "number"
      },
      "evidence": {
       "type": "number"
      },
      "actionability": {
       "type": "number"
      }
     },
     "required": [
      "correctness",
      "completeness",
      "risk",
      "evidence",
      "actionability"
     ]
    }
   }
  },
  "findings": {
   "type": "array",
   "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
     "id",
     "severity",
     "claim",
     "evidence",
     "recommendation",
     "blocking"
    ],
    "properties": {
     "id": {
      "type": "string",
      "minLength": 1
     },
     "severity": {
      "enum": [
       "BLOCKER",
       "MAJOR",
       "MINOR",
       "NOTE"
      ]
     },
     "claim": {
      "type": "string",
      "minLength": 1
     },
     "evidence": {
      "type": "string",
      "minLength": 1
     },
     "recommendation": {
      "type": "string"
     },
     "blocking": {
      "type": "boolean"
     }
    }
   }
  },
  "assumptions": {
   "type": "array",
   "items": {
    "type": "string"
   }
  },
  "confidence": {
   "type": "number",
   "minimum": 0,
   "maximum": 1
  },
  "summary": {
   "type": "string",
   "minLength": 1
  }
 }
}