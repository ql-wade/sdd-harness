+export async function knowledgeWork(options: { projectRoot: string; host: Readonly<ManagedDeliveryHost>; tuple: ManagedRecord; action: string; facts: ManagedRecord[]; artifacts: ManagedRecord }): Promise<ManagedRecord> {
+  const { host } = options;
