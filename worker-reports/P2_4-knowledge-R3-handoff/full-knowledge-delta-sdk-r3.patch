+    if(createHash('sha256').update(payload.bytes).digest('hex') !== tuple.payloadDigest) fail('original knowledge payload changed');
+  }
+  const reviews = facts.filter(fact => knowledgeAction(fact.ref.action)?.stage === 'review');
