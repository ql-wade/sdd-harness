diff --git a/test/app/matt-method-profile.test.ts b/test/app/matt-method-profile.test.ts
new file mode 100644
--- /dev/null
+++ b/test/app/matt-method-profile.test.ts
@@ -0,0 +1,30 @@
+import { expect, it } from 'vitest';
+import { promises as fs } from 'fs';
+import os from 'os';
+import path from 'path';
+import { copyCometSkillsForPlatform } from '../../domains/skill/platform-install.js';
+import { PLATFORMS } from '../../platform/install/platforms.js';
+
+it.each(['skills', 'skills-zh'])('Classic platform installation ships actual Matt bindings: %s', async (language) => {
+  const project = await fs.mkdtemp(path.join(os.tmpdir(), 'comet-method-install-'));
+  try {
+    const platform = PLATFORMS.find((item) => item.id === 'claude')!;
+    const result = await copyCometSkillsForPlatform(project, platform, true, language, 'project', 'copy', 'classic');
+    expect(result.failed).toBe(0);
+    const installed = path.join(project, '.claude/skills');
+    const design = await fs.readFile(path.join(installed, 'comet-design/SKILL.md'), 'utf8');
+    expect(design).toContain('grill-me');
+    expect(design).not.toMatch(/load the Superpowers `brainstorming`|加载 Superpowers `brainstorming`/);
+    const profile = await fs.readFile(path.join(installed, 'comet-classic/reference/method-profile.md'), 'utf8');
+    for (const method of ['comet-managed-v2', 'multi-agent-consensus-review', 'test-authoring', 'whitebox-verify', 'UNQUALIFIED']) {
+      expect(profile).toContain(method);
+    }
+    for (const phase of ['comet-open', 'comet-design', 'comet-build', 'comet-verify', 'comet-archive']) {
+      expect(await fs.readFile(path.join(installed, phase, 'SKILL.md'), 'utf8')).toBe(
+        await fs.readFile(path.join('assets', language, phase, 'SKILL.md'), 'utf8'),
+      );
+    }
+  } finally {
+    await fs.rm(project, { recursive: true, force: true });
+  }
+});
