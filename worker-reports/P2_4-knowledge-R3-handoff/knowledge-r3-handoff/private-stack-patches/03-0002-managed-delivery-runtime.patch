+import { findClassicArchiveChangeDirectory } from './classic-paths.js';
+// Identity facts come only from the fixed bootstrap policy, never CLI/env data.
+// Byte identity is not I02 OS/UID/image qualification or a publication grant.
+import { createHash } from 'node:crypto';
+import { promises as fs } from 'node:fs';
+import path from 'node:path';
+import {
+  requireManagedDeliveryHost,
+  ManagedSourceUnverifiedError,
+  type ManagedRecord,
+} from './classic-managed-host.js';
+import { stableStringify } from './classic-gate-runtime.js';
+import { readClassicState } from './classic-store.js';
+
+export const OPENSPEC_ARTIFACT_SHA256 =
+  '84820b173b57204bd7582a47ddae65e85fd492724172acc8e434e97ea1c05c3f';
+const HEX = /^[a-f0-9]{64}$/u;
+const hash = (bytes: string | Buffer) => createHash('sha256').update(bytes).digest('hex');
+const bad = (message: string): never => {
+  throw new ManagedSourceUnverifiedError(`UNVERIFIED: OpenSpec binding ${message}`);
+};
+const object = (value: unknown): value is ManagedRecord =>
+  value !== null && typeof value === 'object' && !Array.isArray(value);
+const inside = (root: string, target: string) => {
+  const rel = path.relative(root, target);
+  return rel === '' || (!path.isAbsolute(rel) && rel !== '..' && !rel.startsWith(`..${path.sep}`));
+};
+const relative = (value: unknown): value is string =>
+  typeof value === 'string' &&
+  value !== '' &&
+  !path.isAbsolute(value) &&
+  !value.includes(String.fromCharCode(92)) &&
+  !value.split('/').some((part) => part === '' || part === '.' || part === '..');
+
+export interface OpenSpecInvocation {
+  origin: { projectRoot: string; changeDir: string; runId?: string };
+  binding: ManagedRecord;
+  digest: string;
+}
+
+export async function managedOpenSpecInvocation(
+  projectRoot: string,
+  changeDir: string,
+  runId?: string,
+): Promise<OpenSpecInvocation> {
+  const originalExists = await fs.lstat(changeDir).then(() => true, (error: NodeJS.ErrnoException) => { if (error.code === 'ENOENT') return false; throw error; });
+  let state = originalExists ? await readClassicState(changeDir, { migrate: false }) : { classic: null, run: null, unknownKeys: [] };
+  if (runId && !state.run) {
+    const archived = await findClassicArchiveChangeDirectory(path.basename(changeDir), projectRoot);
+    if (!archived) return bad('original Run is unavailable after the operation');
+    changeDir = archived.directory;
+    state = await readClassicState(changeDir, { migrate: false });
+  }
+  if (!state.classic?.managedDelivery || (runId && state.run?.runId !== runId))
+    bad('is not linked to the same managed Run');
+  const origin = { projectRoot, changeDir, runId };
+  const policy = requireManagedDeliveryHost().policy(origin);
+  const binding = policy?.openSpecBinding;
+  if (!object(binding) || binding.schema !== 'comet.openspec.binding.v1')
+    bad('is missing from the protected policy');
+  if (binding.scope !== 'component-mechanism' && binding.scope !== 'registered-runner')
+    bad('scope is invalid');
+  if ((policy.executionScope ?? 'business') !== 'component-mechanism') {
+    if (
+      binding.scope !== 'registered-runner' ||
+      !object(binding.qualification) ||
+      typeof binding.qualification.ref !== 'string' ||
+      !binding.qualification.ref ||
+      binding.qualification.ref === 'UNVERIFIED' ||
+      !HEX.test(binding.qualification.digest ?? '')
+    )
+      bad('has no registered production qualification');
+  } else if (binding.scope !== 'component-mechanism')
+    bad('does not match the protected mechanism scope');
+  if (
+    !HEX.test(binding.environmentDigest ?? '') ||
+    policy.controllerEnvironmentDigest !== binding.environmentDigest
+  )
+    bad('does not match the current controller environment');
+  const digest = hash(stableStringify(binding));
+  if (state.run && runId && state.run.runId !== runId) bad('belongs to another Run');
+  if (state.classic?.deliveryPolicy) {
+    const frozen = JSON.parse(state.classic.deliveryPolicy);
+    if (!object(frozen.openSpecBinding) || hash(stableStringify(frozen.openSpecBinding)) !== digest)
+      bad('differs from the original delivery_policy snapshot');
+  }
+  return { origin, binding: structuredClone(binding), digest };
+}
+
+// Observes the COMPLETE installed tree, including lookup-relevant directories
+// and in-root npm links. A manifest cannot omit an extra or changed dependency.
+async function installationEntries(root: string): Promise<ManagedRecord[]> {
+  const entries: ManagedRecord[] = [];
+  const walk = async (directory: string): Promise<void> => {
+    for (const item of (await fs.readdir(directory, { withFileTypes: true })).sort((a, b) =>
+      a.name.localeCompare(b.name),
+    )) {
+      const target = path.join(directory, item.name);
+      const name = path.relative(root, target).split(path.sep).join('/');
+      if (item.isSymbolicLink()) {
+        const link = await fs.readlink(target);
+        const resolved = await fs.realpath(target);
+        if (!inside(root, resolved)) bad('dependency link escapes the registered installation');
+        entries.push({ path: name, type: 'link', sha256: hash(link) });
+      } else if (item.isDirectory()) {
+        entries.push({ path: name, type: 'directory' });
+        await walk(target);
+      } else if (item.isFile())
+        entries.push({ path: name, type: 'file', sha256: hash(await fs.readFile(target)) });
+      else bad('installation contains an unsupported target');
+    }
+  };
+  await walk(root);
+  return entries;
+}
+
+export async function verifyOpenSpecInvocation(invocation: OpenSpecInvocation): Promise<void> {
+  const current = await managedOpenSpecInvocation(
+    invocation.origin.projectRoot,
+    invocation.origin.changeDir,
+    invocation.origin.runId,
+  );
+  if (
+    current.digest !== invocation.digest ||
+    hash(stableStringify(invocation.binding)) !== invocation.digest
+  )
+    bad('changed across the operation');
+  const binding = invocation.binding;
+  if (
+    !object(binding.artifact) ||
+    binding.artifact.name !== '@fission-ai/openspec' ||
+    binding.artifact.version !== '1.11.0' ||
+    binding.artifact.tarballSha256 !== OPENSPEC_ARTIFACT_SHA256 ||
+    typeof binding.artifact.evidenceRef !== 'string' ||
+    !binding.artifact.evidenceRef
+  )
+    bad('does not reference the pinned P1_1 artifact');
+  if (
+    !object(binding.node) ||
+    typeof binding.node.path !== 'string' ||
+    !path.isAbsolute(binding.node.path) ||
+    !HEX.test(binding.node.sha256 ?? '')
+  )
+    bad('Node identity is invalid');
+  if (
+    (await fs.realpath(binding.node.path)) !== binding.node.path ||
+    hash(await fs.readFile(binding.node.path)) !== binding.node.sha256
+  )
+    bad('Node bytes or identity changed');
+  if (
+    typeof binding.installationRoot !== 'string' ||
+    !path.isAbsolute(binding.installationRoot) ||
+    (await fs.realpath(binding.installationRoot)) !== binding.installationRoot ||
+    path.basename(binding.installationRoot) !== 'node_modules'
+  )
+    bad('installation root is not the registered canonical tree');
+  if (!relative(binding.cliEntry) || binding.cliEntry !== '@fission-ai/openspec/bin/openspec.js')
+    bad('CLI entry is outside the pinned package');
+  if (
+    !object(binding.manifest) ||
+    typeof binding.manifest.path !== 'string' ||
+    !path.isAbsolute(binding.manifest.path) ||
+    !HEX.test(binding.manifest.sha256 ?? '')
+  )
+    bad('closure manifest identity is missing');
+  const bytes = await fs.readFile(binding.manifest.path);
+  if (hash(bytes) !== binding.manifest.sha256) bad('closure manifest changed');
+  const manifest = JSON.parse(bytes.toString('utf8'));
+  if (
+    !object(manifest) ||
+    manifest.schema !== 'comet.openspec.installation-manifest.v1' ||
+    manifest.artifactSha256 !== OPENSPEC_ARTIFACT_SHA256 ||
+    !Array.isArray(manifest.entries) ||
+    manifest.entries.length === 0
+  )
+    bad('closure manifest is invalid');
+  for (const entry of manifest.entries) {
+    if (
+      !object(entry) ||
+      !relative(entry.path) ||
+      !['file', 'directory', 'link'].includes(entry.type) ||
+      (entry.type !== 'directory' && !HEX.test(entry.sha256 ?? ''))
+    )
+      bad('closure entry is invalid');
+  }
+  if (
+    stableStringify(await installationEntries(binding.installationRoot)) !==
+    stableStringify(manifest.entries)
+  )
+    bad('CLI/package/dependency bytes or lookup tree changed');
+  const pkg = JSON.parse(
+    await fs.readFile(
+      path.join(binding.installationRoot, '@fission-ai/openspec/package.json'),
+      'utf8',
+    ),
+  );
+  if (pkg.name !== binding.artifact.name || pkg.version !== binding.artifact.version)
+    bad('package metadata does not match the pin');
+}
+
+export function boundOpenSpecEnvironment(): NodeJS.ProcessEnv {
+  const env: NodeJS.ProcessEnv = { ...process.env, OPENSPEC_TELEMETRY: '0' };
+  for (const key of Object.keys(env))
+    if (
+      /^(?:NODE_OPTIONS|NODE_PATH|NODE_REPL_EXTERNAL_MODULE|NODE_V8_COVERAGE|NODE_COMPILE_CACHE|NODE_REDIRECT_WARNINGS|COMET_OPENSPEC)$/iu.test(
+        key,
+      ) ||
+      /^(?:LD_|DYLD_)/iu.test(key)
+    )
+      delete env[key];
+  // PATH never selects the launcher: absolute Node + fixed CLI entry are used.
+  return env;
+}
