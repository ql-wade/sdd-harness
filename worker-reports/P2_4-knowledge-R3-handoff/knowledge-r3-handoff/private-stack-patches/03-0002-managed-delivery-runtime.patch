+    consumedCollections: recorded.map((receipt) => receipt.sourceEntry.collectionId),
+    issuedExecutions: recorded.map((receipt) => receipt.sourceEntry.execution),
+  });
+  if (!admitted.ok)
+    throw new ManagedSourceUnverifiedError(
+      `UNVERIFIED: collected source was not admitted (${admitted.error})`,
+    );
+  return evaluateManagedSource(intent, admitted.entry, receipts);
+}
