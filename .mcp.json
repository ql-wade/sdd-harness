{
  "mcpServers": {
    "opendeepwiki": {
      "type": "url",
      "url": "http://localhost:8095/api/mcp/ql-wade/sdd-harness"
    },
    "playwright": {
      "command": "npx",
      "args": [
        "@playwright/mcp@latest"
      ]
    },
    "chrome-devtools": {
      "command": "npx",
      "args": [
        "chrome-devtools-mcp@latest"
      ]
    },
    "github": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-github"
      ],
      "env": {
        "GITHUB_TOKEN": "${GITHUB_TOKEN}"
      }
    },
    "llmwiki": {
      "command": "${CLAUDE_PROJECT_DIR}/tools/mcp/llmwiki.sh",
      "args": []
    }
  }
}
